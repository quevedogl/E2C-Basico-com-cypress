{
  "name": "balaroti-cypress",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "http-server app -p 3000 -c-1 --silent",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "verificar:esperas": "node scripts/verificar-esperas.js",
    "pretest": "npm run verificar:esperas",
    "test": "start-server-and-test start http://localhost:3000 cy:run",
    "test:3x": "start-server-and-test start http://localhost:3000 \"npm run cy:run && npm run cy:run && npm run cy:run\"",
    "test:open": "start-server-and-test start http://localhost:3000 cy:open"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "http-server": "^14.1.1",
    "start-server-and-test": "^2.0.8"
  }
}
